{
  "name": "code-analysis-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "docker compose up --build",
    "build": "pnpm --filter api build && pnpm --filter worker build && pnpm --filter frontend build"
